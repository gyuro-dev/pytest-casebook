{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gyuro-dev/pytest-casebook/main/src/pytest_casebook/casebook.schema.json",
  "title": "pytest-casebook case file / pytest-casebook のケースファイル",
  "description": "How to write casebook_*.yaml. Used by editors (e.g. the YAML extension for VS Code) for key completion and validation. / casebook_*.yaml の書き方。エディタ（VS Code の YAML 拡張など）でキーの補完と検証に使う。",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "Heading in the report (defaults to the file name) / レポートの見出し（省略時はファイル名）"
    },
    "description": {
      "type": "string",
      "description": "Description shown in the report / レポートに出す説明"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of the hierarchy levels (e.g. [Category, Subcategory, Item]) / 階層の呼び名（例: [大項目, 中項目, 小項目]）"
    },
    "states": {
      "type": "object",
      "description": "State name -> contents (a named setup:). Selected with state: on a case or group / 状態名 -> 内容（名前を付けた setup:）。ケースやグループの state: で選ぶ",
      "additionalProperties": {
        "$ref": "#/$defs/setup"
      }
    },
    "command_prefix": {
      "description": "Arguments put before every command. {casebook_dir} becomes the directory of the YAML / どの command にも先頭に付ける引数。{casebook_dir} は YAML のディレクトリになる",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "golden_dir": {
      "type": "string",
      "description": "Where golden files are stored (relative to this file) / 期待出力の置き場所（このファイルからの相対パス）"
    },
    "check_orphans": {
      "type": "boolean",
      "description": "Fail if golden files without a case are left over / ケースがない期待出力が残っていたら失敗にする"
    },
    "normalize": {
      "type": "array",
      "description": "Replacements applied to the output / 出力に当てる置き換え",
      "items": {
        "type": "object",
        "required": [
          "pattern"
        ],
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "description": "Regular expression / 正規表現"
          },
          "replace": {
            "type": "string",
            "description": "Replacement / 置き換え後"
          }
        }
      }
    },
    "request_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "$ref": "#/$defs/headers"
        }
      },
      "description": "Defaults merged into every request: / どの request: にも重ねる既定の値"
    },
    "meta": {
      "type": "object",
      "description": "Free-form information (pytest-casebook does not read it) / 自由に使う情報（pytest-casebook は見ない）"
    },
    "cases": {
      "$ref": "#/$defs/items"
    }
  },
  "$defs": {
    "items": {
      "type": "array",
      "description": "A list of cases or groups / ケースまたはグループのリスト",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/group"
          },
          {
            "$ref": "#/$defs/case"
          }
        ]
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "object",
      "required": [
        "group"
      ],
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1,
          "description": "Group name (the nesting depth becomes the hierarchy level) / グループの名前（入れ子の深さが階層になる）"
        },
        "description": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "Default state of the cases inside / 中のケースの既定の状態"
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "object"
        },
        "skip": {
          "$ref": "#/$defs/reason",
          "description": "Skip every case inside, for this reason / 中のケースすべてを、この理由でスキップする"
        },
        "xfail": {
          "$ref": "#/$defs/reason",
          "description": "Every case inside is expected to fail, for this reason / 中のケースすべてが、この理由で失敗すると分かっている"
        },
        "cases": {
          "$ref": "#/$defs/items"
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "call"
          ]
        },
        {
          "required": [
            "request"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[\\w.\\-]+$",
          "description": "Case name (becomes the golden file name) / ケース名（期待出力のファイル名になる）"
        },
        "description": {
          "type": "string",
          "description": "What is checked / 確認する内容"
        },
        "command": {
          "description": "Arguments to run as a CLI. A list is passed as is, without splitting (useful for Windows paths) / CLI として実行する引数。リストで書くと区切らずにそのまま渡す（Windows のパス向け）",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "stdin": {
          "type": "string"
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "call": {
          "type": "string",
          "pattern": "^[^:\\s]+:[^:\\s]+$",
          "description": "module:function / モジュール:関数"
        },
        "args": {
          "type": "array"
        },
        "kwargs": {
          "type": "object"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "state": {
          "type": "string"
        },
        "setup": {
          "$ref": "#/$defs/setup"
        },
        "observe": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Targets fetched after the run (files, etc.) / 実行後に取り出す対象（files など）"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "object"
        },
        "skip": {
          "$ref": "#/$defs/reason"
        },
        "xfail": {
          "$ref": "#/$defs/reason"
        },
        "golden": {
          "type": "string",
          "description": "Golden file name (defaults to <name>.txt) / 期待出力のファイル名（省略時は <name>.txt）"
        }
      }
    },
    "setup": {
      "type": [
        "object",
        "null"
      ],
      "description": "Preconditions. files are put in the working directory; everything else is passed to pytest_casebook_setup / 前提条件。files は作業ディレクトリに置くファイル、それ以外は pytest_casebook_setup に渡す",
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\s*(([Gg][Ee][Tt]|[Pp][Oo][Ss][Tt]|[Pp][Uu][Tt]|[Pp][Aa][Tt][Cc][Hh]|[Dd][Ee][Ll][Ee][Tt][Ee]|[Hh][Ee][Aa][Dd]|[Oo][Pp][Tt][Ii][Oo][Nn][Ss])\\s+)?/\\S*\\s*$",
          "description": "\"METHOD PATH\" (GET if the method is omitted) / \"メソッド パス\"（メソッドを省くと GET）"
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "not": {
            "required": [
              "json",
              "body"
            ]
          },
          "properties": {
            "method": {
              "type": "string",
              "pattern": "^([Gg][Ee][Tt]|[Pp][Oo][Ss][Tt]|[Pp][Uu][Tt]|[Pp][Aa][Tt][Cc][Hh]|[Dd][Ee][Ll][Ee][Tt][Ee]|[Hh][Ee][Aa][Dd]|[Oo][Pp][Tt][Ii][Oo][Nn][Ss])$"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "query": {
              "type": "object"
            },
            "headers": {
              "$ref": "#/$defs/headers"
            },
            "json": {
              "description": "JSON body / JSON の本文"
            },
            "body": {
              "type": "string",
              "description": "Non-JSON body / JSON 以外の本文"
            }
          }
        }
      ]
    },
    "text": {
      "description": "A string matches exactly, {contains: ...} matches a substring, {regex: ...} matches a regular expression / 文字列なら完全一致、{contains: ...} なら含む、{regex: ...} なら正規表現",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "contains": {
              "type": "string"
            },
            "regex": {
              "type": "string"
            },
            "$contains": {
              "type": "string"
            },
            "$regex": {
              "type": "string"
            }
          }
        }
      ]
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "description": "Expected results. Only the items written here are compared. Other keys are observe targets (db.users, etc.) / 期待結果。ここに書いた項目だけを比べる。下の項目以外のキーは observe の対象（db.users など）",
      "not": {
        "required": [
          "return",
          "raises"
        ]
      },
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "stdout": {
          "$ref": "#/$defs/text"
        },
        "stderr": {
          "$ref": "#/$defs/text"
        },
        "return": {
          "description": "Dicts compare only the keys written, lists compare the count and each item. $contains, $regex, $unordered and $includes can be used / 辞書は書いたキーだけ、リストは件数と各要素を比べる。$contains・$regex・$unordered・$includes が使える"
        },
        "raises": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "type": "integer"
        },
        "json": {
          "description": "Compared the same way as return / return と同じ比べ方"
        },
        "body": {
          "$ref": "#/$defs/text"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
